PARTNER_GATEWAY_BASE_URL=http://127.0.0.1:8765
PARTNER_GATEWAY_API_KEY=

# 客户端运行时（登录后 session / auth/me 会覆盖下列默认值）
NEXT_PUBLIC_HER_REQUESTER_ID=70001
NEXT_PUBLIC_HER_PROFILE_ID=10001
NEXT_PUBLIC_HER_USER_ID=user-a
NEXT_PUBLIC_HER_CASE_ID=case-frontend-demo
# 可选：Demo 导航直进聊天时的默认会话（case-frontend-demo / user-a 下的 assistant_dm_a）
# NEXT_PUBLIC_HER_DEMO_CONVERSATION_ID=cvt-e85e4e9266f64d1a

# 行为开关 — 生产环境必须均为 false（CI production-build job 会校验）
# NEXT_PUBLIC_ALLOW_MOCK_FALLBACK=true  仅 dev：API 失败时允许 DemoDataBanner + 本地 fixtures
NEXT_PUBLIC_ALLOW_MOCK_FALLBACK=false
# NEXT_PUBLIC_ENABLE_DEMO_NAV=true     仅 dev：右下角 Demo 导航
NEXT_PUBLIC_ENABLE_DEMO_NAV=false
# NEXT_PUBLIC_USE_AUTH_STUB=true       仅 dev + 根目录 HER_AUTH_* stub 联调
NEXT_PUBLIC_USE_AUTH_STUB=false

# 字段认证写回由 gateway 服务端配置，勿放入 NEXT_PUBLIC：
# HER_PROFILE_SOURCE_DSN=mysql://root@127.0.0.1:3307/her?table=profiles
# HER_PROFILE_SOURCE_TABLE=profiles

# 发布前请参阅 frontend/her-app/docs/RELEASE_CHECKLIST.md（§13.2.6 验收）
