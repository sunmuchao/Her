# Schema init mode
# 开发机默认可用 migrate；预发/生产建议改成 validate
HER_SCHEMA_INIT_MODE=migrate

# Recommendation DB
PARTNER_RECOMMENDATION_DB=mysql://root@127.0.0.1:3307/her_recommendation

# Matchmaking DB
PARTNER_MATCHMAKING_DB=mysql://root@127.0.0.1:3307/her_matchmaking

# Chat DB
PARTNER_CHAT_DB=mysql://root@127.0.0.1:3307/her_chat
PARTNER_CHAT_TEST_DB=mysql://root@127.0.0.1:3307/her_chat_test

# Discovery DB
PARTNER_DISCOVERY_DB=mysql://root@127.0.0.1:3307/her_discovery
PARTNER_DISCOVERY_TEST_DB=mysql://root@127.0.0.1:3307/her_discovery_test

# Persona memory DB
# 通过 ?table=profiles 指定共享主资料表
PERSONA_MEMORY_MYSQL_SOURCE=mysql://root@127.0.0.1:3307/her?table=profiles

# Matchmaker C runtime
# 不要把真实 key 提交进仓库；本文件只保留占位符。
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
HER_CHAT_AGENT_MODEL=glm-5
HER_CHAT_AGENT_RUNTIME=agents_sdk
HER_CHAT_AGENT_OPENAI_API=chat_completions
HER_CHAT_AGENT_DISABLE_TRACING=1

# Discovery agent runtime
# discovery 建议单独接百炼 Responses 官方兼容端点，不要复用 chat 的 `coding.dashscope.aliyuncs.com/v1`
HER_DISCOVERY_AGENT_RUNTIME=agents_sdk
# HER_DISCOVERY_AGENT_API_KEY=replace-with-your-discovery-provider-key
# HER_DISCOVERY_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# HER_DISCOVERY_AGENT_MODEL=qwen3.6-plus
# HER_DISCOVERY_AGENT_WIRE_API=responses
# HER_DISCOVERY_AGENT_OPENAI_API=responses
# HER_DISCOVERY_PROFILE_SOURCE=mysql://root@127.0.0.1:3307/her?table=profiles

# Maintenance toggles
HER_SCHED_CHAT_FLUSH_OUTBOX=1
HER_SCHED_CHAT_OUTBOX_CONSUME=1
HER_SCHED_RECOMMENDATION_OUTBOX_SEC=30
HER_SCHED_MATCHMAKING_OUTBOX_SEC=30
HER_SCHED_CHAT_OUTBOX_SEC=15
HER_CHAT_OUTBOX_BATCH_LIMIT=200
HER_CHAT_OUTBOX_MAX_BATCHES=1
HER_CHAT_OUTBOX_RETRY_DELAY_SECONDS=60
HER_CHAT_OUTBOX_RETRY_BACKOFF_MULTIPLIER=2
HER_CHAT_OUTBOX_RETRY_MAX_DELAY_SECONDS=600
HER_CHAT_OUTBOX_MAX_ATTEMPTS=3
HER_CHAT_OUTBOX_CLAIM_TIMEOUT_SECONDS=300
HER_CHAT_OUTBOX_POLL_INTERVAL_SECONDS=15
HER_CHAT_OUTBOX_MAX_IDLE_POLLS=3
# Optional: recommendation / matchmaking outbox worker tuning
# HER_RECOMMENDATION_OUTBOX_BATCH_LIMIT=200
# HER_RECOMMENDATION_OUTBOX_MAX_BATCHES=1
# HER_RECOMMENDATION_OUTBOX_RETRY_DELAY_SECONDS=60
# HER_RECOMMENDATION_OUTBOX_RETRY_BACKOFF_MULTIPLIER=2
# HER_RECOMMENDATION_OUTBOX_RETRY_MAX_DELAY_SECONDS=600
# HER_RECOMMENDATION_OUTBOX_MAX_ATTEMPTS=3
# HER_RECOMMENDATION_OUTBOX_CLAIM_TIMEOUT_SECONDS=300
# HER_RECOMMENDATION_OUTBOX_POLL_INTERVAL_SECONDS=15
# HER_RECOMMENDATION_OUTBOX_MAX_IDLE_POLLS=3
# HER_MATCHMAKING_OUTBOX_BATCH_LIMIT=200
# HER_MATCHMAKING_OUTBOX_MAX_BATCHES=1
# HER_MATCHMAKING_OUTBOX_RETRY_DELAY_SECONDS=60
# HER_MATCHMAKING_OUTBOX_RETRY_BACKOFF_MULTIPLIER=2
# HER_MATCHMAKING_OUTBOX_RETRY_MAX_DELAY_SECONDS=600
# HER_MATCHMAKING_OUTBOX_MAX_ATTEMPTS=3
# HER_MATCHMAKING_OUTBOX_CLAIM_TIMEOUT_SECONDS=300
# HER_MATCHMAKING_OUTBOX_POLL_INTERVAL_SECONDS=15
# HER_MATCHMAKING_OUTBOX_MAX_IDLE_POLLS=3
HER_CHAT_MAINTENANCE_SKIP_ASSISTANT=0
HER_CHAT_MAINTENANCE_SKIP_SUMMARY=0

# Live-video verification
HER_VERIFICATION_PROVIDER=local_oss
# 默认走本地开源活体链路
# 可选：Silent-Face / Whisper 模型缓存目录
# HER_VERIFICATION_LOCAL_CACHE_DIR=/absolute/path/to/verification-models
# HER_VERIFICATION_WHISPER_MODEL=tiny
