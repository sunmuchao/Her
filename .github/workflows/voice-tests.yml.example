# Voice Transcription CI/CD Configuration Example

# This file shows how to integrate voice transcription tests into CI/CD pipelines

name: Voice Transcription Tests

on:
  push:
    branches: [ main, develop ]
    paths:
      - 'external-systems/partner-http-gateway/gateway/voice_routes.py'
      - 'frontend/her-app/hooks/use-voice-input.ts'
      - 'frontend/her-app/lib/api/endpoints/voice.ts'
  pull_request:
    branches: [ main ]
    paths:
      - 'external-systems/partner-http-gateway/gateway/voice_routes.py'
      - 'frontend/her-app/hooks/use-voice-input.ts'
      - 'frontend/her-app/lib/api/endpoints/voice.ts'

jobs:
  # Job 1: Backend Unit Tests
  backend-unit-tests:
    name: Backend Unit Tests
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pytest pytest-cov faster-whisper==1.2.1

      - name: Run backend unit tests
        run: |
          cd external-systems/partner-http-gateway
          pytest gateway_tests/test_voice_routes.py -m unit -v --cov=gateway.voice_routes --cov-report=xml

      - name: Upload coverage
        uses: codecov/codecov-action@v4
        with:
          files: external-systems/partner-http-gateway/coverage.xml
          flags: backend-voice

  # Job 2: Frontend Unit Tests
  frontend-unit-tests:
    name: Frontend Unit Tests
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: 9

      - name: Install dependencies
        run: |
          cd frontend/her-app
          pnpm install

      - name: Run frontend unit tests
        run: |
          cd frontend/her-app
          pnpm run test:voice

      - name: Upload coverage
        uses: codecov/codecov-action@v4
        with:
          files: frontend/her-app/coverage/coverage-final.json
          flags: frontend-voice

  # Job 3: Integration Tests (Optional, requires GPU or long runtime)
  integration-tests:
    name: Integration Tests (Whisper)
    runs-on: ubuntu-latest
    continue-on-error: true  # Don't fail pipeline if integration tests fail

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pytest requests faster-whisper==1.2.1

      - name: Download Whisper model cache
        uses: actions/cache@v4
        with:
          path: ~/.cache/huggingface
          key: whisper-model-${{ runner.os }}
          restore-keys: |
            whisper-model-

      - name: Create test audio fixture
        run: |
          cd external-systems/partner-http-gateway/tests/fixtures
          # Create a minimal WAV file for testing
          python3 -c "
          import wave
          with wave.open('test_zh.wav', 'wb') as f:
              f.setnchannels(1)
              f.setsampwidth(2)
              f.setframerate(16000)
              f.writeframes(b'\x00\x00' * 16000)
          "

      - name: Run integration tests
        run: |
          cd external-systems/partner-http-gateway
          pytest gateway_tests/test_voice_routes.py::TestVoiceTranscriptionIntegration -v

      - name: Run E2E tests (requires full system)
        run: |
          # Start gateway in background
          python -m gateway &
          GATEWAY_PID=$!

          # Wait for gateway to start
          sleep 10

          # Run E2E test
          cd external-systems/partner-http-gateway/tests
          python test_voice_e2e.py || true  # E2E may fail without real audio

          # Stop gateway
          kill $GATEWAY_PID

# Performance benchmarks (optional)
  performance-tests:
    name: Performance Benchmarks
    runs-on: ubuntu-latest
    continue-on-error: true

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install dependencies
        run: |
          pip install -r requirements.txt
          pip install pytest-benchmark faster-whisper==1.2.1

      - name: Run performance benchmarks
        run: |
          cd external-systems/partner-http-gateway
          pytest gateway_tests/test_voice_routes.py --benchmark-only --benchmark-autosave

      - name: Upload benchmark results
        uses: actions/upload-artifact@v4
        with:
          name: benchmark-results
          path: external-systems/partner-http-gateway/.benchmarks/