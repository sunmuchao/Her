 'Result Group Title'}, 'selected_candidates': {'items': {'$ref': '#/$defs/DiscoveryCandidateSelectionModel'}, 'title': 'Selected Candidates', 'type': 'array'}}, 'required': ['phase', 'assistant_message', 'criteria_labels', 'suggested_actions', 'result_group_title', 'selected_candidates'], 'title': 'DiscoveryDecisionModel', 'type': 'object', 'additionalProperties': False}, 'strict': True}}, 'tools': [{'name': 'sync_requester_persona_memory', 'parameters': {'properties': {'patch_json': {'title': 'Patch Json', 'type': 'string'}}, 'required': ['patch_json'], 'title': 'sync_requester_persona_memory_args', 'type': 'object', 'additionalProperties': False}, 'strict': True, 'type': 'function', 'description': ''}, {'name': 'search_partner_candidates', 'parameters': {'properties': {'criteria_json': {'title': 'Criteria Json', 'type': 'string'}, 'limit': {'default': 5, 'title': 'Limit', 'type': 'integer'}}, 'required': ['criteria_json', 'limit'], 'title': 'search_partner_candidates_args', 'type': 'object', 'additionalProperties': False}, 'strict': True, 'type': 'function', 'description': ''}, {'name': 'create_saved_search_subscription_from_last_search', 'parameters': {'properties': {}, 'title': 'create_saved_search_subscription_from_last_search_args', 'type': 'object', 'additionalProperties': False, 'required': []}, 'strict': True, 'type': 'function', 'description': ''}]}}
