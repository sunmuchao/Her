s': None, 'last_active_at': '2026-05-27 15:23:26', 'matcher_traits_json': None, 'matcher_preferences_json': None, 'matcher_risks_json': None, 'matcher_summary_internal': None, 'accept_marital_status_semantics': None, 'accept_partner_children_semantics': None, 'location_preference_semantics': None, 'requires_partner_accept_my_children': None, 'public_display_name': None, 'public_education': None, 'public_job': None, 'public_personality': None, 'public_values': None, 'public_notes': None, 'matcher_traits': {}, 'matcher_preferences': {}, 'matcher_risks': {}, 'source_file': 'mysql://root@127.0.0.1:3307/her?table=profiles#profiles', 'income_min_wan': None, 'income_max_wan': None, 'combined_text': '孙木超 | 上海 | dating | 未婚', 'self_relationship_goal': 'dating'}, 'source_map': {'gender': {'source': 'explicit_override', 'field': 'gender'}, 'age_min': {'source': 'explicit_statement', 'field': 'target_age_min'}, 'age_max': {'source': 'explicit_statement', 'field': 'target_age_max'}, 'cities': {'source': 'explicit_statement', 'field': 'target_cities'}, 'relationship_goals': {'source': 'explicit_statement', 'field': 'self_relationship_goal'}}, 'criteria_hash': 'c480730c817aca19d23b4310b5d853f6c050247b70bd2fbfa6a7991019a273bb', 'scene': 'discovery_search'}, 'source_map': {'gender': {'source': 'explicit_override', 'field': 'gender'}, 'age_min': {'source': 'explicit_statement', 'field': 'target_age_min'}, 'age_max': {'source': 'explicit_statement', 'field': 'target_age_max'}, 'cities': {'source': 'explicit_statement', 'field': 'target_cities'}, 'relationship_goals': {'source': 'explicit_statement', 'field': 'self_relationship_goal'}}}}", 'type': 'function_call_output'}], 'instructions': '你是发现页里的 AI 红娘。\n\n你的职责：\n1. 和用户自然对话，帮她/他整理择偶偏好。\n2. 后端已经把当前正式状态放进 official_context。你要以它为准。\n3. 你自己决定什么时候继续追问，什么时候先写画像，什么时候调用搜索工具。\n4. 只有用户说出了明确、稳定、适合落库的新信息时，才调用画像写回工具。\n5. 常见顺序是：先写画像，再搜索。\n6. 如果条件还不够，就只问 1 个最关键的问题。\n7. 如果条件已经够用，就调用搜索工具。\n8. 如果搜索到结果，你负责决定展示哪几位、重点强调什么。\n9. 但你不能编造候选人的原始卡片字段。你只能输出 profile_id 和 reason_summary，后端会去填卡片标题、照片、认证等稳定字段。\n\nofficial_context 里常见信息：\n- requester_profile_snapshot：用户当前画像快照\n- recent_timeline_summary：最近几轮页面时间线摘要\n- visible_actions：当前页面还能点哪些 action\n- last_search_summary：最近一轮搜索摘要\n- page_summary：当前页面上的 criteria chips、结果卡片摘要等\n\n工具说明：\n- `sync_requester_persona_memory`：把用户刚刚明确说出的稳定画像写回 persona-memory-sync。\n  - 参数 `patch_json` 必须是 JSON 字符串，对应 persona-memory-sync 的 patch 对象。\n  - 常见字段可以用：self_city, self_relationship_goal, self_smoking, self_drinking, target_gender, target_age_min, target_age_max, target_cities, must_have_tags, must_not_have_tags, preferred_traits, disliked_traits。\n  - 例子：{"self_city":"上海","self_relationship_goal":"认真恋爱","must_not_have_tags":["抽烟"]}.\n- `search_partner_candidates`：执行候选搜索。\n  - 参数 `criteria_json` 必须是 JSON 字符串，对应 partner-search 的 criteria 对象。\n  - 常见字段可以用：gender, city, cities, age_min, age_max, relationship_goal, relationship_goals, must_have, prefer, smoking, drinking, verified_level_min, photo_count_min, active_within_days。\n  - 例子：{"gender":"女","cities":["无锡"],"relationship_goals":["认真恋爱"],"must_have":["情绪稳定"],"prefer":["工作稳定"]}.\n  - 如果工具返回了 `error_code` 或 `diagnostics.error`，说明这轮搜索失败了，不是没有候选人。\n- `create_saved_search_subscription_from_last_search`：把上一轮 0 结果搜索保存成“持续留意”订阅。\n  - 只有在用户已经明确同意“继续留意”时才能调用。\n  - 不要在还有匹配结果时调用。\n\n工具调用要求：\n- 需要用工具时，必须走系统提供的真实 tool calling 机制。\n- 不要把 `tool_calls`、`function_call`、工具参数对象手写进最终 JSON。\n- 不要输出形如 `{"tool_calls":[...]}` 的文本。\n- 工具调用完成后，再输出最终 JSON。\n- 最终 JSON 只能包含 DiscoveryDecisionModel 定义的字段，不能包含 `tool_calls` 之类额外字段。\n\n输出原则：\n- assistant_message 保持短，像真人红娘，不要写成系统说明。\n- phase 只能是：collecting_preferences、searching、results_shown、no_result。不要自造 phase 名。\n- 如果你正在展示候选卡片，phase 必须是 `results_shown`。\n- criteria_labels 用于给前端展示条件 chips，最多 6 个。\n- suggested_actions 最多 3 个，标签要短。\n- suggested_actions.style 只能是：primary、secondary、ghost。\n- semantic_payload.kind 只用这些值：starter_prompt、followup_prompt、saved_search_opt_in、refine_candidates、add_criteria、refine_preferences、show_more_candidates、age_preference。\n- 如果你刚拿到了新的明确画像，通常应先调用 `sync_requester_persona_memory`，再决定是否搜索。\n- 只有在你真的调用了搜索工具并且决定展示结果时，才填写 selected_candidates。\n- selected_candidates 里的 profile_id 必须来自最新一次搜索工具返回的 results。\n- 如果搜索工具返回 `error_code` 或 `diagnostics.error`，不要说“本地没有符合条件的人”。要自然说明这轮搜索失败了，不代表没人，并引导用户重试或继续补充条件。\n- 如果没有合适结果，phase 用 no_result，message 里自然说明，并给 1 到 2 个放宽方向。\n- 如果搜索 0 结果且你判断适合引导持续留意，可以给一个 action，semantic_payload 里放 `{"kind":"saved_search_opt_in"}`。\n- 如果本轮是 action_click，且 clicked_action.hint.kind 是 `saved_search_opt_in`，说明用户刚刚同意了持续留意；这时你应该优先调用 `create_saved_search_subscription_from_last_search`，再告诉用户你已经记下。\n\n输出必须是合法 JSON，只输出结构化结果，不要加代码块。', 'model': 'qwen3.6-plus', 'text': {'format': {'type': 'json_schema', 'name': 'final_output', 'schema': {'$defs': {'DiscoveryActionSuggestionModel': {'properties': {'label': {'title': 'Label', 'type': 'string'}, 'style': {'default': 'secondary', 'enum': ['primary', 'secondary', 'ghost'], 'title': 'Style', 'type': 'string'}, 'semantic_payload': {'anyOf': [{'discriminator': {'mapping': {'add_criteria': '#/$defs/DiscoveryAddCriteriaPayloadModel', 'age_preference': '#/$defs/DiscoveryAgePreferencePayloadModel', 'followup_prompt': '#/$defs/DiscoveryFollowupPromptPayloadModel', 'refine_candidates': '#/$defs/DiscoveryRefineCandidatesPayloadModel', 'refine_preferences': '#/$defs/DiscoveryRefinePreferencesPayloadModel', 'saved_search_opt_in': '#/$defs/DiscoverySavedSearchOptInPayloadModel', 'show_more_candidates': '#/$defs/DiscoveryShowMoreCandidatesPayloadModel', 'starter_prompt': '#/$defs/DiscoveryStarterPromptPayloadModel'}, 'propertyName': 'kind'}, 'anyOf': [{'$ref': '#/$defs/DiscoveryStarterPromptPayloadModel'}, {'$ref': '#/$defs/DiscoveryFollowupPromptPayloadModel'}, {'$ref': '#/$defs/DiscoverySavedSearchOptInPayloadModel'}, {'$ref': '#/$defs/DiscoveryRefineCandidatesPayloadModel'}, {'$ref': '#/$defs/DiscoveryAddCriteriaPayloadModel'}, {'$ref': '#/$defs/DiscoveryRefinePreferencesPayloadModel'}, {'$ref': '#/$defs/DiscoveryShowMoreCandidatesPayloadModel'}, {'$ref': '#/$defs/DiscoveryAgePreferencePayloadModel'}]}, {'type': 'null'}], 'title': 'Semantic Payload'}}, 'required': ['label', 'style', 'semantic_payload'], 'title': 'DiscoveryActionSuggestionModel', 'type': 'object', 'additionalProperties': False}, 'DiscoveryAddCriteriaPayloadModel': {'properties': {'kind': {'const': 'add_criteria', 'title': 'Kind', 'type': 'string'}}, 'required': ['kind'], 'title': 'DiscoveryAddCriteriaPayloadModel', 'type': 'object', 'additionalProperties': False}, 'DiscoveryAgePreferencePayloadModel': {'properties': {'kind': {'const': 'age_preference', 'title': 'Kind', 'type': 'string'}, 'target_gender': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'title': 'Target Gender'}, 'age_min': {'anyOf': [{'minimum': 18, 'type': 'integer'}, {'type': 'null'}], 'title': 'Age Min'}, 'age_max': {'anyOf': [{'minimum': 18, 'type': 'integer'}, {'type': 'null'}], 'title': 'Age Max'}, 'age_gap_max': {'anyOf': [{'minimum': 0, 'type': 'integer'}, {'type': 'null'}], 'title': 'Age Gap Max'}, 'flexible': {'anyOf': [{'type': 'boolean'}, {'type': 'null'}], 'title': 'Flexible'}}, 'required': ['kind', 'target_gender', 'age_min', 'age_max', 'age_gap_max', 'flexible'], 'title': 'DiscoveryAgePreferencePayloadModel', 'type': 'object', 'additionalProperties': False}, 'DiscoveryCandidateSelectionModel': {'properties': {'profile_id': {'minimum': 1, 'title': 'Profile Id', 'type': 'integer'}, 'reason_summary': {'default': '', 'title': 'Reason Summary', 'type': 'string'}}, 'required': ['profile_id', 'reason_summary'], 'title': 'DiscoveryCandidateSelectionModel', 'type': 'object', 'additionalProperties': False}, 'DiscoveryFollowupPromptPayloadModel': {'properties': {'kind': {'const': 'followup_prompt', 'title': 'Kind', 'type': 'string'}, 'slot': {'enum': ['age_range', 'city_intent'], 'title': 'Slot', 'type': 'string'}}, 'required': ['kind', 'slot'], 'title': 'DiscoveryFollowupPromptPayloadModel', 'type': 'object', 'additionalProperties': False}, 'Discovery