FROM python:3.11-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    default-libmysqlclient-dev \
    ffmpeg \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY her_*.py outer_system_mysql_schema.py outer_mysql_compat.py partner_moderation.py profile_*.py mysql_source_config.py ./
COPY match_domain ./match_domain
COPY observability ./observability
COPY async_jobs ./async_jobs
COPY task_scheduler ./task_scheduler
COPY db_migrations ./db_migrations
COPY relationship_ledger ./relationship_ledger
COPY partner_search ./partner_search
COPY persona_memory_sync ./persona_memory_sync
COPY profile_service ./profile_service
COPY assessment ./assessment
COPY external-systems ./external-systems
COPY scripts ./scripts
COPY config ./config

RUN PIP_DEFAULT_TIMEOUT=180 pip install --no-cache-dir -e ".[dev]" faster-whisper

ENV PYTHONUNBUFFERED=1
ENV PARTNER_GATEWAY_DB_POOL_MAX=16
ENV PARTNER_SEARCH_CACHE_TTL_SECONDS=120
