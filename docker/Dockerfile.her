# ============================================================
# 第一阶段：Builder（安装依赖，包含编译工具）
# ============================================================
FROM python:3.11-slim-bookworm AS builder

WORKDIR /app

# 设置 pip 配置
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_EXTRA_INDEX_URL=
ENV PIP_DEFAULT_TIMEOUT=180
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_RETRIES=20
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
ENV PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL}

# 安装编译依赖（这些工具只在构建阶段需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    default-libmysqlclient-dev \
    ffmpeg \
    pkg-config \
    libffi-dev \
    libgomp1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 升级 pip 工具
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# 先复制依赖定义文件（这些文件很少改变）
COPY pyproject.toml README.md ./

# 复制 external-systems 目录（pyproject.toml 引用了这些包）
COPY external-systems ./external-systems

# 创建最小化的项目结构（支持 editable install）
# 这些目录只需要 __init__.py 文件，实际代码在第二阶段复制
RUN mkdir -p match_domain observability async_jobs task_scheduler \
    db_migrations relationship_ledger partner_search persona_memory_sync \
    profile_service assessment scripts config \
    && touch match_domain/__init__.py observability/__init__.py \
    async_jobs/__init__.py task_scheduler/__init__.py \
    db_migrations/__init__.py relationship_ledger/__init__.py \
    partner_search/__init__.py persona_memory_sync/__init__.py \
    profile_service/__init__.py assessment/__init__.py

# 复制项目根目录的 Python 文件（这些是 py_modules）
COPY her_*.py outer_system_mysql_schema.py outer_mysql_compat.py \
    partner_moderation.py profile_*.py mysql_source_config.py ./

# 安装所有依赖（这一层会被缓存，除非 pyproject.toml 改变）
# 将超大依赖拆层安装，避免网络抖动时整批依赖重下
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --trusted-host files.pythonhosted.org --trusted-host pypi.org --trusted-host download.pytorch.org --retries 20 --timeout 1800 --prefer-binary torch --index-url https://download.pytorch.org/whl/cpu

# TensorFlow 体积很大，单独安装并增加显式重试，避免 IncompleteRead 时整批依赖失败
RUN --mount=type=cache,target=/root/.cache/pip \
    sh -c 'for attempt in 1 2 3; do \
        pip install --trusted-host files.pythonhosted.org --trusted-host pypi.org --retries 20 --timeout 1800 --prefer-binary tensorflow tf-keras \
        && exit 0; \
        echo "[retry] tensorflow install failed attempt=${attempt}" >&2; \
        sleep 10; \
    done; \
    exit 1'

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --trusted-host files.pythonhosted.org --trusted-host pypi.org --retries 20 --timeout 1800 --prefer-binary --no-build-isolation -e ".[dev,local_oss]" faster-whisper

# 预下载 DeepFace Facenet512 权重，避免首个用户请求触发同步下载
# 添加重试机制，应对网络不稳定
RUN mkdir -p /root/.deepface/weights \
    && python - <<'PY'
import os
import sys
import time

weights_dir = "/root/.deepface/weights"
weights_path = os.path.join(weights_dir, "facenet512_weights.h5")
print(f"[preload] facenet512 target={weights_path}")

if os.path.exists(weights_path):
    print("[preload] facenet512 weights already exist")
    sys.exit(0)

# 重试机制：最多重试3次
max_retries = 3
for attempt in range(max_retries):
    try:
        print(f"[preload] 尝试下载 facenet512 (第 {attempt + 1}/{max_retries} 次)...")
        from deepface import DeepFace
        DeepFace.build_model("Facenet512")
        print(f"[preload] facenet512 下载成功 exists={os.path.exists(weights_path)}")
        sys.exit(0)
    except Exception as e:
        print(f"[preload] 下载失败: {e}")
        if attempt < max_retries - 1:
            wait_time = 10 * (attempt + 1)  # 递增等待时间
            print(f"[preload] 等待 {wait_time} 秒后重试...")
            time.sleep(wait_time)
        else:
            print("[preload] 达到最大重试次数，跳过预下载")
            print("[preload] 模型将在首次使用时下载")
            sys.exit(0)  # 不阻塞构建，让容器启动后再下载
PY

# ============================================================
# 第二阶段：Runtime
# 直接继承 builder，避免复制大体积 site-packages 时触发 Docker 磁盘空间耗尽
# ============================================================
FROM builder AS runtime

WORKDIR /app

# builder 阶段已经包含运行所需依赖与预下载权重

# 复制所有代码文件（经常改变，放在最后）
COPY her_*.py outer_system_mysql_schema.py outer_mysql_compat.py \
    partner_moderation.py profile_*.py mysql_source_config.py ./
COPY match_domain ./match_domain
COPY observability ./observability
COPY async_jobs ./async_jobs
COPY task_scheduler ./task_scheduler
COPY db_migrations ./db_migrations
COPY relationship_ledger ./relationship_ledger
COPY partner_search ./partner_search
COPY persona_memory_sync ./persona_memory_sync
COPY profile_service ./profile_service
COPY assessment ./assessment
COPY external-systems ./external-systems
COPY scripts ./scripts
COPY config ./config

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV PARTNER_GATEWAY_DB_POOL_MAX=16
ENV PARTNER_SEARCH_CACHE_TTL_SECONDS=120
